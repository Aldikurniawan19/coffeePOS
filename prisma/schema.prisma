datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String   // SHA-256 hashed
  name      String
  role      String   // "owner", "kasir", or "barista"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  id         Int      @id @default(autoincrement())
  shopName   String   @default("Coffee Shop POS")
  address    String   @default("Jl. Kopi No. 123, Jakarta")
  phone      String?  @default("081234567890")
  footerNote String?  @default("Terima kasih telah berkunjung!")
  updatedAt  DateTime @updatedAt
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int               @id @default(autoincrement())
  name        String
  price       Float
  image       String?           // URL atau Base64/path gambar produk
  description String?
  type        String            @default("Minuman") // "Minuman", "Makanan", "Barang"
  stock       Int               @default(0)
  isAvailable Boolean           @default(true)
  categoryId  Int?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items       TransactionItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Staff {
  id                Int           @id @default(autoincrement())
  name              String
  code              String        @unique
  role              String        @default("Barista") // "Barista", "Kasir", "Waitstaff"
  commissionCut     Float         @default(0)
  commissionProduct Float         @default(0)
  status            String        @default("Active") // "Active" or "Inactive"
  transactions      Transaction[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model Transaction {
  id            Int               @id @default(autoincrement())
  code          String            @unique
  totalAmount   Float
  paymentMethod String            // "Tunai", "Debit/EDC", "QRIS"
  customerName  String            @default("Walk-in (Pelanggan)")
  orderType     String            @default("Dine-in") // "Dine-in", "Takeaway"
  tableNumber   String?           // Nomor Meja (opsional untuk Dine-in)
  staffId       Int?
  staff         Staff?            @relation(fields: [staffId], references: [id], onDelete: SetNull)
  staffName     String?
  staffComm     Float             @default(0)
  items         TransactionItem[]
  createdAt     DateTime          @default(now())
}

model TransactionItem {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     Int?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  price         Float
  qty           Int
  type          String      @default("Minuman") // "Minuman", "Makanan", "Barang"
  notes         String?     // Catatan pesanan (misal: "Less Ice", "Extra Shot")
}
